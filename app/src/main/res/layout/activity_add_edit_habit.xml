<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_add_edit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusableInTouchMode="true">

        <!-- 📝 Nom de l’habitude -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/HabitEditText"
            android:id="@+id/input_habit_name"
            android:hint="Nom de l’habitude"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp"
            android:textSize="18sp"
            android:padding="14dp"
            android:background="@drawable/input_background" />

        <!-- 📅 Jours de répétition -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jours de répétition"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="7"
            android:layout_marginBottom="20dp">

            <CheckBox android:id="@+id/check_mon" android:text="Lun" style="@style/HabitCheckbox" />
            <CheckBox android:id="@+id/check_tue" android:text="Mar" style="@style/HabitCheckbox" />
            <CheckBox android:id="@+id/check_wed" android:text="Mer" style="@style/HabitCheckbox" />
            <CheckBox android:id="@+id/check_thu" android:text="Jeu" style="@style/HabitCheckbox" />
            <CheckBox android:id="@+id/check_fri" android:text="Ven" style="@style/HabitCheckbox" />
            <CheckBox android:id="@+id/check_sat" android:text="Sam" style="@style/HabitCheckbox" />
            <CheckBox android:id="@+id/check_sun" android:text="Dim" style="@style/HabitCheckbox" />
        </LinearLayout>

        <!-- 🧠 Icône -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Icône"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <!-- 🎨 Couleur -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleur"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- ⏰ Rappel -->
        <Switch
            android:id="@+id/switch_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer un rappel"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layout_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#F7F7F7"
            android:visibility="gone"
            android:layout_marginBottom="24dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Heure de rappel"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Heure -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                tools:visibility="visible"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:onClick="onReminderTimeClick"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:layout_marginEnd="12dp"
                    app:tint="@android:color/darker_gray" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_reminder_time"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Heure du rappel"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/text_reminder_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:textSize="16sp"
                        android:padding="12dp"
                        android:drawableStart="@drawable/ic_clock"
                        android:drawablePadding="12dp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Spinner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quand ?"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginEnd="16dp" />

                <Spinner
                    android:id="@+id/spinner_reminder_offset"
                    android:layout_width="0dp"
                    style="@style/AppSpinnerStyle"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>

        <!-- ✅ Enregistrement -->
        <Button
            android:id="@+id/btn_save_habit"
            android:layout_width="match_parent"
            style="@style/HabitButton"
            android:layout_height="wrap_content"
            android:text="Enregistrer l’habitude"
            android:textStyle="bold"
            android:padding="14dp"
            android:textColor="@android:color/white"
            android:backgroundTint="?attr/colorPrimary"
            android:elevation="4dp"
            android:layout_marginBottom="32dp" />
    </LinearLayout>
</ScrollView>
