<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/habit_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/habit_icon_wrapper"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/ripple_circle"
            android:elevation="4dp">

            <TextView
                android:id="@+id/habit_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="22sp"
                android:text="🔥"
                android:textColor="@android:color/white"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nom de l’habitude"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_repeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lun, Mer, Ven"
                android:textSize="14sp"
                android:textColor="#666" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/text_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mois"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            style="@style/HabitButton"
            android:id="@+id/btn_prev"  android:layout_height="40dp"
            android:text="←"  android:layout_width="wrap_content"/>

        <Button
            style="@style/HabitButton"
            android:id="@+id/btn_next"  android:layout_height="40dp"
            android:text="→"   android:layout_width="wrap_content"/>

        <Switch
            android:id="@+id/switch_mode"
            android:text="Semaine"  android:layout_height="40dp"  android:layout_width="wrap_content"/>
    </LinearLayout>

    <TextView
        android:id="@+id/text_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chaîne actuelle :"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/calendar_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
