<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_emoji"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/cardBackground">

    <!-- 😍 Titre -->
    <TextView
        android:id="@+id/label_emoji_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisissez une icône"
        android:textAppearance="@style/TextAppearance_Habit_Title"
        android:layout_marginBottom="16dp" />

    <!-- 🔹 Grille d’émojis -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/grid_emoji_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:columnCount="6"
        android:layout_marginBottom="20dp" />

    <!-- 🌟 Pro block -->
    <LinearLayout
        android:id="@+id/layout_pro_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_pro_hint"
        android:padding="14dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        android:gravity="center">

        <TextView
            android:id="@+id/text_pro_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌟 Plus d'icônes sont disponibles avec la version Pro"
            android:textColor="@color/primaryAccent"
            android:textAlignment="center"
            android:textStyle="italic"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_go_pro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Débloquer la version Pro"
            android:textAllCaps="false"
            style="@style/Button_Primary" />
    </LinearLayout>

    <!-- ❌ Annuler -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_cancel_emoji_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Annuler"
        android:backgroundTint="@color/red"
        android:textColor="@android:color/white" />
</LinearLayout>
