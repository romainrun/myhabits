<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".fragment.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:clipChildren="false">

        <!-- Citation motivante -->
        <TextView
            android:id="@+id/text_motivation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:textAlignment="center"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="28dp"
            android:layout_marginTop="16dp"
            android:text="Motivation ici ✨" />

        <!-- Pourcentage de complétion -->
        <TextView
            android:id="@+id/text_progress_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp" />

        <!-- Barre de progression stylisée -->
        <ProgressBar
            android:id="@+id/progress_day"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/glow_progress"
            android:layout_marginBottom="20dp" />

        <!-- Aujourd’hui -->
        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:text="Aujourd’hui"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_habits_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/text_empty_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune habitude aujourd’hui 😴"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/darker_gray" />

        <!-- En retard -->
        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:text="Tâches en retard"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_habits_missed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/text_empty_missed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucune tâche en retard 👌"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:textColor="@android:color/darker_gray" />

        <!-- Demain -->
        <TextView
            style="@style/TextAppearance.Material3.TitleMedium"
            android:text="Pour demain"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_habits_tomorrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/text_empty_tomorrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rien de prévu demain 😎"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="32dp"
            android:textColor="@android:color/darker_gray" />

    </LinearLayout>
</ScrollView>
