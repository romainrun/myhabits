<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pro_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:padding="24dp">

    <!-- ✨ PRO NON ACHETÉ -->
    <LinearLayout
        android:id="@+id/layout_pro_not_purchased"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_pro"
        android:padding="32dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:elevation="10dp"
        android:clipToPadding="false">

        <!-- 🎨 Illustration -->
        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_pro_illustration"
            android:layout_marginBottom="28dp" />

        <!-- 🏆 Titre accrocheur -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passez à Pro ✨"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="16dp" />

        <!-- 📋 Liste des bénéfices -->
        <TextView
            android:id="@+id/text_pro_features_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textSecondary"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:textAlignment="viewStart"
            android:layout_marginBottom="20dp" />

        <!-- 💸 Prix -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seulement 2,99 € – à vie"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primaryAccent"
            android:layout_marginBottom="28dp" />

        <!-- 🔓 Bouton action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_buy_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Débloquer Pro maintenant"
            style="@style/Button_Primary"
            android:textSize="17sp"
            android:textAllCaps="false"
            android:paddingVertical="14dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ✅ PRO ACHETÉ -->
    <LinearLayout
        android:id="@+id/layout_pro_purchased"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_pro"
        android:padding="32dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Merci pour votre soutien ❤️"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vous avez débloqué toutes les fonctionnalités Pro suivantes :"
            android:textSize="16sp"
            android:textColor="@color/textSecondary"
            android:textAlignment="viewStart"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/textProFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textColor="@color/textSecondary"
            android:lineSpacingExtra="6dp"
            android:textAlignment="viewStart" />
    </LinearLayout>
</FrameLayout>
