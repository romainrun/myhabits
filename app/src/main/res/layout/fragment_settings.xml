<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Premier jour de la semaine -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Premier jour de la semaine"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_first_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:backgroundTint="@color/primaryAccent"
            android:popupBackground="@color/cardBackground" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Préférences"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="16dp" />

        <!-- Format 24H -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchFormat24H"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Utiliser le format 24h"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="24dp" />

        <!-- Notifications -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifications activées"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="24dp" />

        <!-- Son -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Son de rappel"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/text_sound_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucun son sélectionné"
            android:textColor="@color/textSecondary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_select_sound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choisir un son"
            style="@style/Button_Outlined"
            android:layout_marginBottom="24dp" />

        <!-- Vibration -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_vibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vibration"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="24dp" />

        <!-- Snooze -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Durée du snooze"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_snooze_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="5 minutes"
            android:inputType="number"
            android:textColor="@color/textPrimary"
            android:background="@drawable/bg_edittext_rounded"
            android:padding="12dp"
            android:layout_marginBottom="32dp" />



        <!-- 🔁 Réinitialisation -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_reset_preferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Réinitialiser les paramètres"
            android:textColor="@color/red"
            style="@style/Button_Outlined" />


    </LinearLayout>
</ScrollView>
