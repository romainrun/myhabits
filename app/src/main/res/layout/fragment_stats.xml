<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_stats"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top">

        <!-- 📊 Titre principal -->
        <TextView
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Statistiques générales"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/textPrimary"
            android:layout_marginBottom="28dp" />

        <!-- ✅ Statistiques -->
        <TextView
            android:id="@+id/textTotalHabits"
            style="@style/StatLine"
            android:text="Total d’habitudes : 0" />

        <TextView
            android:id="@+id/textTotalChecks"
            style="@style/StatLine"
            android:text="Total de validations : 0" />

        <TextView
            android:id="@+id/textBestStreak"
            style="@style/StatLine"
            android:text="Meilleur enchaînement : 0 jours" />

        <TextView
            android:id="@+id/textMostFrequent"
            style="@style/StatLine"
            android:text="Habitude la plus régulière : -" />

        <!-- 🔄 Ajout possible d'autres blocs -->

    </LinearLayout>
</ScrollView>
