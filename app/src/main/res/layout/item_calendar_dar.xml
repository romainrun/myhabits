<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_add_edit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?android:colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nom de l’habitude -->
        <EditText
            android:id="@+id/input_habit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nom de l’habitude"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Jours de la semaine -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jours de répétition"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="7"
            android:layout_marginBottom="16dp">

            <CheckBox android:id="@+id/check_mon" android:text="Lun" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/check_tue" android:text="Mar" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/check_wed" android:text="Mer" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/check_thu" android:text="Jeu" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/check_fri" android:text="Ven" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/check_sat" android:text="Sam" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
            <CheckBox android:id="@+id/check_sun" android:text="Dim" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Sélection de l’icône -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Icône"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_icons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Sélection de la couleur -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Couleur"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Rappel -->
        <Switch
            android:id="@+id/switch_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer un rappel"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layout_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Heure : "
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_reminder_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:paddingStart="8dp"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Bouton sauvegarder -->
        <Button
            style="@style/HabitButton"
            android:id="@+id/btn_save_habit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enregistrer l’habitude"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="12dp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
