<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="20dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/primaryAccent"
    app:strokeWidth="0.5dp"
    app:cardBackgroundColor="@color/cardBackground"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/habit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_toStartOf="@id/habit_calendar_button"
            android:gravity="center_vertical">

            <!-- 🧘 Emoji -->
            <FrameLayout
                android:id="@+id/habit_icon_wrapper"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                android:backgroundTint="@color/primaryAccent"
                android:background="@drawable/bg_circle">

                <TextView
                    android:id="@+id/habit_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="22sp"
                    android:text="🔥"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 📋 Infos -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:lineSpacingExtra="4dp">

                <TextView
                    android:id="@+id/habit_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance_Habit_Title"
                    android:text="Nom de l’habitude" />

                <TextView
                    android:id="@+id/habit_repeat_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance_Habit_Subtitle"
                    android:text="Lun, Mer, Ven" />

                <TextView
                    android:id="@+id/text_reminder_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextAppearance_Habit_Subtitle"
                    android:text="🕐 08:00"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/text_routine_name"
                    style="@style/RoutineTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Routine : Santé"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/text_habit_level"
                    style="@style/TextAppearance_Habit_Level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Niveau 1 – Débutant 🐣"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 🔴 Importance -->
            <TextView
                android:id="@+id/text_importance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴"
                android:textSize="18sp"
                android:layout_marginStart="8dp" />

            <!-- ☑️ Check invisible -->
            <CheckBox
                android:id="@+id/habit_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 📅 Calendrier -->
        <ImageButton
            android:id="@+id/habit_calendar_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voir calendrier"
            android:src="@drawable/ic_calendar"
            app:tint="@color/primaryAccent" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
