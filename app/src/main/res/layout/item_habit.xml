<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:backgroundTint="@android:color/white"
    app:cardBackgroundColor="@android:color/white"
    app:strokeColor="#DDDDDD"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/habit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/habit_calendar_button"
            android:gravity="center_vertical">

            <!-- 💡 Icone -->
            <FrameLayout
                android:id="@+id/habit_icon_wrapper"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/habit_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:text="🔥"
                    android:textColor="@android:color/white" />
            </FrameLayout>

            <!-- 💡 Infos habitude -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp">

                <TextView
                    android:id="@+id/habit_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nom de l’habitude"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black" />

                <TextView
                    android:id="@+id/habit_repeat_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lun, Mer, Ven"
                    android:textSize="13sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/text_reminder_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕐 08:00"
                    android:textSize="14sp"
                    android:textColor="#666"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/text_routine_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Routine : Santé"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/routine_tag_background"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />

                <TextView
                    android:id="@+id/text_habit_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Niveau 1 – Débutant 🐣"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 🔥 Importance -->
            <TextView
                android:id="@+id/text_importance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴"
                android:textSize="16sp"
                android:layout_marginStart="8dp" />

            <!-- ☑️ Check (invisible par défaut) -->
            <CheckBox
                android:id="@+id/habit_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 📆 Calendrier -->
        <ImageButton
            android:id="@+id/habit_calendar_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voir calendrier"
            android:src="@drawable/ic_calendar"
            app:tint="?attr/colorPrimary" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
